#!/bin/sh
# debian-usb managed pre-push hook
set -eu
IFS=$(printf '\n\t')
export LC_ALL=C

repo_root=$(git rev-parse --show-toplevel) || {
  printf '%s\n' 'debian-usb pre-push: unable to resolve repository root' >&2
  exit 2
}
[ -x "${repo_root}/secrets.sh" ] || {
  printf '%s\n' 'debian-usb pre-push: missing executable secrets.sh' >&2
  exit 2
}
[ -x "${repo_root}/scripts/check-secrets.py" ] || {
  printf '%s\n' 'debian-usb pre-push: missing executable scripts/check-secrets.py' >&2
  exit 2
}
command -v python3 >/dev/null 2>&1 || {
  printf '%s\n' 'debian-usb pre-push: python3 is required' >&2
  exit 2
}

# Clear worktree values first. The scanner then checks the immutable index and
# each outgoing commit snapshot, so staged/history leaks cannot be hidden.
"${repo_root}/secrets.sh" --clear >/dev/null
exec python3 "${repo_root}/scripts/check-secrets.py" --pre-push
