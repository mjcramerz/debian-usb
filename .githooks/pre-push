#!/bin/sh
# debian-usb managed pre-push hook
IFS=$(printf '\n\t')
export LC_ALL=C

if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
  printf '%s\n' 'debian-usb pre-push: unable to resolve repository root; continuing without blocking push' >&2
  exit 0
fi
if [ -z "${repo_root}" ] || [ "${repo_root}" = / ]; then
  printf '%s\n' 'debian-usb pre-push: unsafe repository root; continuing without blocking push' >&2
  exit 0
fi
if [ ! -x "${repo_root}/secrets.sh" ]; then
  printf '%s\n' 'debian-usb pre-push: missing executable secrets.sh; continuing without blocking push' >&2
  exit 0
fi

printf '%s\n' 'debian-usb pre-push: clearing initrd .env/.conf secret values'
if ! "${repo_root}/secrets.sh" --clear-initrd --index; then
  printf '%s\n' 'debian-usb pre-push: secret clearing failed; continuing without blocking push' >&2
fi
exit 0
