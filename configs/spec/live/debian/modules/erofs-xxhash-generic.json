{
  "schema_version": 1,
  "name": "Debian Live boot, persistence, compression, and USB modules",
  "description": "Repo-managed Debian Live initramfs profile for EROFS, xxhash/LZ4 compression, overlay persistence, storage, and CH341 serial support.",
  "distro": "debian",
  "stage": "live",
  "kind": "modules",
  "enabled_by_default": true,
  "module_names": [
    "erofs",
    "xxhash",
    "xxhash_generic",
    "lz4",
    "lz4_compress",
    "lz4_decompress",
    "loop",
    "squashfs",
    "overlay",
    "ext4",
    "dm_mod",
    "dm_crypt",
    "usb_storage",
    "uas",
    "nvme",
    "usbserial",
    "ch341"
  ],
  "live_initramfs_modules": [
    "erofs",
    "xxhash",
    "xxhash_generic",
    "lz4",
    "lz4_compress",
    "lz4_decompress",
    "loop",
    "squashfs",
    "overlay",
    "ext4",
    "dm_mod",
    "dm_crypt",
    "usb_storage",
    "uas",
    "nvme",
    "usbserial",
    "ch341"
  ],
  "module_alias_candidates": [
    "xxhash64",
    "xxhash64-generic",
    "xxhash64_generic",
    "xxhash_generic",
    "crypto-xxhash64",
    "crypto-xxhash64-generic",
    "crypto_xxhash64",
    "crypto_xxhash64_generic"
  ],
  "kernel_config_symbols": [
    "CONFIG_EROFS_FS",
    "CONFIG_EROFS_FS_XATTR",
    "CONFIG_EROFS_FS_ZIP",
    "CONFIG_XXHASH",
    "CONFIG_CRYPTO_XXHASH",
    "CONFIG_CRYPTO_LZ4",
    "CONFIG_LZ4_COMPRESS",
    "CONFIG_LZ4_DECOMPRESS",
    "CONFIG_BLK_DEV_LOOP",
    "CONFIG_SQUASHFS",
    "CONFIG_OVERLAY_FS",
    "CONFIG_EXT4_FS",
    "CONFIG_BLK_DEV_DM",
    "CONFIG_DM_CRYPT",
    "CONFIG_USB_STORAGE",
    "CONFIG_USB_UAS",
    "CONFIG_BLK_DEV_NVME",
    "CONFIG_USB_SERIAL",
    "CONFIG_USB_SERIAL_CH341"
  ],
  "extra_chroot_packages": [
    "initramfs-tools",
    "kmod",
    "xxhash",
    "lz4",
    "zstd"
  ],
  "extra_binary_packages": [],
  "local_deb_dir": "",
  "local_udeb_dir": "",
  "udeb_rebuild_spec_path": "",
  "source_overlay_dir": "",
  "kernel_version": "",
  "notes": [
    "MODULES=most is paired with an explicit early-load list for boot, overlay persistence, storage, and CH341 serial devices.",
    "The Build ISO flow validates loadable modules and modules.builtin before publishing a Debian Live ISO."
  ]
}
