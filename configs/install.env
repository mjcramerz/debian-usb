APP_NAME="debian-usb"
APP_SLUG="debian-usb"
BIN_NAME="debian-usb"
APP_VERSION="0.1.0"
PREFIX="/usr"
BINDIR="/usr/bin"
ETC_DIR="/etc/debian-usb"
CONF_FILE="/etc/debian-usb/debian-usb.conf"
LIBEXEC_DIR="/usr/lib/debian-usb"
SPEC_DIR="/usr/lib/debian-usb/spec"
GRUB_SPEC_DIR="/usr/lib/debian-usb/spec/grub"
PRESEED_DIR="/usr/lib/debian-usb/preseed"
INITRD_DIR="/usr/lib/debian-usb/initrd"
PERSISTENCE_DIR="/usr/lib/debian-usb/persistence"
PYTHON_INSTALL_DIR="/usr/lib/debian-usb/python"
PYTHON_HELPER_NAME="debian-usb-python"
WRITE_HELPER_NAME="debian-usb-write"
BUILD_ISO_HELPER_NAME="debian-usb-build-iso"
STATE_DIR="/var/lib/debian-usb"
CACHE_DIR="/data/downloads/debian-usb"
LOG_DIR="/var/log/debian-usb"
WORK_DIR="/data/tmp/debian-usb"
DOC_DIR="/usr/share/doc/debian-usb"
PLANNED_EXECUTION_DIR="/data/cfg/debian-usb/planned-executions"
CUSTOM_GRUB_PAYLOAD_PRESEED_DIR="preseed"
APT_DEPS="aria2 coreutils cpio cryptsetup dosfstools e2fsprogs efitools findutils git gpg gzip grub-common grub-efi-amd64-bin grub-efi-amd64-signed shim-signed shim-helpers-amd64-signed initramfs-tools-core mount parted python3 sbsigntool util-linux xorriso"
DEBIAN_ISO_BUILD_APT_DEPS="apt-utils build-essential bzip2 ca-certificates cpio cryptsetup debootstrap devscripts dpkg-dev e2fsprogs erofs-utils fakeroot file gpg initramfs-tools-core live-build parted rsync squashfs-tools systemd-container wget xorriso xz-utils"
BUILD_DEPS="golang-go make"
