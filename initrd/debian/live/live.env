# Debian Live Wi-Fi. Literal data, not shell code. NEVER source this file.
# Fill locally before rebuilding. Empty ESSID disables automatic Wi-Fi setup.
# Credentials are embedded in the ISO/initrd: protect and do not redistribute it.
# Static IPv4: set CIDR, gateway and nameservers; empty CIDR+gateway uses DHCP.
LIVE_WIFI_INTERFACE="auto"
LIVE_WIFI_ESSID="WLAN_RESTRICTED"
LIVE_WIFI_SECURITY="wpa"
LIVE_WIFI_CIDR="192.168.50.1/24"
LIVE_WIFI_GATEWAY="192.168.50.1"
LIVE_WIFI_NAMESERVERS="192.168.50.1"
LIVE_WIFI_PASSPHRASE=''
