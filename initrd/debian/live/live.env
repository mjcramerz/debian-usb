# Debian Live initrd environment. Keep tracked values empty; use ./secrets.sh --set locally.
# Debian Live builds and remasters validate this allowlisted file and stage it with mode 0600.
# The init-bottom helper also copies an embedded /live.env privately into /run when present.
# Wi-Fi values are never transported through GRUB or the kernel command line.

LIVE_WIFI_INTERFACE="wlan0"
LIVE_WIFI_ESSID="VLAN_RESTRICTED"
LIVE_WIFI_SECURITY="wpa"
LIVE_WIFI_CIDR="192.168.102.73/24"
LIVE_WIFI_GATEWAY="192.168.102.1"
LIVE_WIFI_NAMESERVERS="192.168.102.1"

LIVE_WIFI_PASSPHRASE=''

