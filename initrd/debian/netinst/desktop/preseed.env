# Debian Netinst initrd environment. Keep tracked values empty; use ./secrets.sh --set locally.
# This file is merged at /preseed.env only when the Debian Netinst overlay is selected.

# Shared Debian installer Wi-Fi passphrase.
PRESEED_WIFI_PASSPHRASE=''

# Former GRUB variable: fruux_username=
PRESEED_FRUUX_USERNAME=''

# Former GRUB variable: fruux_password=
PRESEED_FRUUX_PASSWORD=''

# Former GRUB variable: primary_user=
PRESEED_PRIMARY_USERNAME=''

# Former GRUB variable: primary_password=
PRESEED_PRIMARY_PASSWORD=''

# Former GRUB variable: primary_gpg_passphrase=
PRESEED_PRIMARY_GPG_PASSPHRASE=''

# Former GRUB variable: root_password=
PRESEED_ROOT_PASSWORD=''

# Former GRUB variable: crowdsec_token=
PRESEED_CROWDSEC_TOKEN=''

# Former GRUB variable: tailscale_authkey=
PRESEED_TAILSCALE_TOKEN=''

# Former GRUB variable: telegram_chat_id=
PRESEED_TELEGRAM_CHAT_ID=''

# Former GRUB variable: telegram_api_key=
PRESEED_TELEGRAM_API_KEY=''

# Former GRUB variable: cf_r2_access_key=
PRESEED_CF_APTLY_ACCESS_KEY=''

# Former GRUB variable: cf_r2_secret_key=
PRESEED_CF_APTLY_SECRET_KEY=''

# Former GRUB variable: obs_username=
PRESEED_OBS_USERNAME=''

# Former GRUB variable: obs_password=
PRESEED_OBS_PASSWORD=''
