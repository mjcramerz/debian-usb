#!/bin/sh
set -eu
IFS=$(printf '\n\t')

script_dir=$(CDPATH='' cd -P "$(dirname "$0")" && pwd -P)

if [ -n "${DEBIAN_USB_PYTHONPATH:-}" ]; then
  python_path=${DEBIAN_USB_PYTHONPATH}
elif [ -d "${script_dir}/python" ]; then
  python_path=${script_dir}/python
elif [ -d "${script_dir}/../src/python" ]; then
  python_path=${script_dir}/../src/python
else
  python_path=/usr/lib/debian-usb/python
fi

export PYTHONPATH="${python_path}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPYCACHEPREFIX="${DEBIAN_USB_PYCACHE_DIR:-/tmp/debian-usb-pycache}"
if [ -z "${DEBIAN_USB_TEMPLATE_CONFIG:-}" ]; then
  if [ -f "${script_dir}/../configs/debian-usb.conf" ]; then
    export DEBIAN_USB_TEMPLATE_CONFIG="${script_dir}/../configs/debian-usb.conf"
  elif [ -f /etc/debian-usb/debian-usb.conf ]; then
    export DEBIAN_USB_TEMPLATE_CONFIG=/etc/debian-usb/debian-usb.conf
  fi
fi
if [ -z "${DEBIAN_USB_SPEC_DIR:-}" ]; then
  if [ -d "${script_dir}/../configs/spec/grub" ]; then
    export DEBIAN_USB_SPEC_DIR="${script_dir}/../configs/spec/grub"
  elif [ -d "${script_dir}/../spec/grub" ]; then
    export DEBIAN_USB_SPEC_DIR="${script_dir}/../spec/grub"
  elif [ -d /usr/lib/debian-usb/spec/grub ]; then
    export DEBIAN_USB_SPEC_DIR=/usr/lib/debian-usb/spec/grub
  fi
fi
exec python3 -m debian_usb.cli "$@"
